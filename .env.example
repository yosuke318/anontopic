# ローカル環境の設定。`cp .env.example .env` してから値を変えて使う。
# compose.yaml は各変数に既定値を持たせているため、.env が無くても起動する。
# 例外は ADMIN_API_TOKEN で、これだけは .env で渡さないと管理 API が生えない。

# PostgreSQL
POSTGRES_USER=anontopic
POSTGRES_PASSWORD=anontopic
POSTGRES_DB=anontopic

# ホスト側に公開するポート。既に使用中の場合だけ変更する。
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=3000

# ブラウザから見た API のオリジン。api サービスのポートを変えたら合わせる。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080

# API が Cookie 付きのリクエストと WebSocket 接続を受け付けるオリジン（カンマ区切り）。
# WEB_PORT を変えたら合わせる。
APP_ALLOWED_ORIGINS=http://localhost:3000

# セッションの IP ハッシュに使う鍵。値を変えると過去のハッシュと一致しなくなり、
# ハッシュに紐づく BAN が効かなくなる。環境ごとに固定した秘密を入れる。
SESSION_IP_HASH_SECRET=local-development-secret

# トピックの管理 API（/api/admin/topics）が要求する Bearer トークン。
# 未設定にすると管理 API 自体が生えないため、公開環境では必ず秘密の値を入れる。
ADMIN_API_TOKEN=local-development-admin-token

# 同時接続の上限と、超えたときに拒否するかどうかを決める値。
# 上限に達している間、新規の WebSocket ハンドシェイクは 503 で拒否する。
# 理由は docs/adr/0013-cap-connections-with-leases-in-redis.md にある。
CAPACITY_MAX_CONNECTIONS=1000

# 1 つの IP ハッシュが同時に持てる接続数。超えた接続は 429 で拒否する。
CAPACITY_MAX_CONNECTIONS_PER_IP=5

# 接続が席を持ち続ける期間と、開いている接続が席を確保し直す間隔。
# 異常終了したサーバーの席は、更新が止まってから LEASE_TTL で空く。
# RENEW_INTERVAL は LEASE_TTL より十分短くする。
CAPACITY_LEASE_TTL=30s
CAPACITY_RENEW_INTERVAL=10s

# メッセージ送信のレート。BURST 連続で送れ、使い切ったあとは INTERVAL に 1 通ずつ回復する。
CAPACITY_MESSAGE_BURST=5
CAPACITY_MESSAGE_INTERVAL=1s

# マッチング要求（POST /api/matching）のレート。IP ハッシュ単位で数える。
CAPACITY_MATCH_BURST=3
CAPACITY_MATCH_INTERVAL=10s
