# ローカル環境の設定。`cp .env.example .env` してから値を変えて使う。
# compose.yaml は各変数に既定値を持たせているため、.env が無くても起動する。

# PostgreSQL
POSTGRES_USER=anontopic
POSTGRES_PASSWORD=anontopic
POSTGRES_DB=anontopic

# ホスト側に公開するポート。既に使用中の場合だけ変更する。
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=3000

# ブラウザから見た API のオリジン。api サービスのポートを変えたら合わせる。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080
